<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Attendance & Payroll Pro Executive</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; -webkit-tap-highlight-color: transparent; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-effect { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(20px); }
        .card-glow { box-shadow: 0 10px 30px -10px rgba(79, 70, 229, 0.15); }
        .emerald-glow { box-shadow: 0 10px 30px -10px rgba(16, 185, 129, 0.2); }
        .pulse-dot { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
        
        .loader {
            width: 36px;
            height: 36px;
            border: 4px solid #4f46e5;
            border-bottom-color: transparent;
            border-radius: 50%;
            display: inline-block;
            box-sizing: border-box;
            animation: rotation 1s linear infinite;
        }
        @keyframes rotation {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-slate-950 min-h-screen text-slate-800 text-[11px] antialiased flex justify-center items-center p-0 sm:p-4">

    <div class="w-full max-w-md bg-slate-50 min-h-screen sm:min-h-[840px] sm:max-h-[900px] sm:rounded-[2.5rem] flex flex-col shadow-2xl relative overflow-hidden border border-slate-800/30">

        <!-- CLOUD LOADING OVERLAY -->
        <div id="cloudLoadingOverlay" class="absolute inset-0 bg-slate-950 z-[300] flex flex-col items-center justify-center sm:rounded-[2.5rem] hidden">
            <span class="loader mb-4"></span>
            <p class="text-white font-semibold text-xs tracking-wider animate-pulse">Syncing Cloud Data...</p>
        </div>

        <!-- AUTHENTICATION SCREEN -->
        <div id="onboardingScreen" class="absolute inset-0 bg-slate-950 z-[200] flex flex-col items-center justify-center px-6 hidden overflow-hidden sm:rounded-[2.5rem]">
            <div class="absolute top-[-10%] left-[-10%] w-40 h-40 bg-indigo-600 rounded-full mix-blend-multiply filter blur-[50px] opacity-30"></div>
            <div class="absolute bottom-[-10%] right-[-10%] w-40 h-40 bg-emerald-600 rounded-full mix-blend-multiply filter blur-[50px] opacity-20"></div>
            
            <div class="w-full bg-slate-900/80 backdrop-blur-xl p-6 rounded-3xl border border-slate-700/50 shadow-2xl relative z-10">
                <div class="text-center mb-5">
                    <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-indigo-700 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-indigo-500/30 border border-indigo-400/30">
                        <i class="fa-solid fa-user-tie text-2xl text-white"></i>
                    </div>
                    <h2 id="authTitle" class="text-xl font-bold text-white tracking-tight">Staff Pro Setup</h2>
                    <p id="authSub" class="text-[10px] text-slate-400 mt-1">Create your executive dashboard</p>
                </div>
                
                <div class="flex justify-center gap-6 mb-5 border-b border-slate-700">
                    <button id="tabLogin" onclick="setAuthMode('login')" class="text-slate-500 font-bold text-xs pb-2 border-b-2 border-transparent transition-all">Login</button>
                    <button id="tabSignup" onclick="setAuthMode('signup')" class="text-indigo-400 font-bold text-xs pb-2 border-b-2 border-indigo-500 transition-all">Naya Account</button>
                </div>

                <div class="space-y-3.5">
                    <div id="nameField">
                        <label class="text-[10px] font-semibold text-slate-300 block mb-1">Your Full Name</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-user text-slate-500 text-[10px]"></i>
                            </div>
                            <input type="text" id="profileName" placeholder="e.g., Chand Rashid" class="w-full text-xs pl-8 p-3 rounded-xl border border-slate-700 bg-slate-800 text-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition placeholder-slate-500">
                        </div>
                    </div>
                    
                    <div>
                        <label class="text-[10px] font-semibold text-slate-300 block mb-1">Email Address</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-envelope text-slate-500 text-[10px]"></i>
                            </div>
                            <input type="email" id="profileEmail" placeholder="your@email.com" class="w-full text-xs pl-8 p-3 rounded-xl border border-slate-700 bg-slate-800 text-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition placeholder-slate-500">
                        </div>
                    </div>

                    <div>
                        <label class="text-[10px] font-semibold text-slate-300 block mb-1">Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-lock text-slate-500 text-[10px]"></i>
                            </div>
                            <input type="password" id="profilePassword" placeholder="Enter password" class="w-full text-xs pl-8 p-3 rounded-xl border border-slate-700 bg-slate-800 text-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition placeholder-slate-500">
                        </div>
                    </div>

                    <div id="confirmPassField">
                        <label class="text-[10px] font-semibold text-slate-300 block mb-1">Confirm Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-shield-halved text-slate-500 text-[10px]"></i>
                            </div>
                            <input type="password" id="profileConfirmPassword" placeholder="Confirm password" class="w-full text-xs pl-8 p-3 rounded-xl border border-slate-700 bg-slate-800 text-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition placeholder-slate-500">
                        </div>
                    </div>

                    <button id="authSubmitBtn" onclick="handleAuthSubmit()" class="w-full mt-2 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-800 text-white font-bold text-xs shadow-lg shadow-indigo-600/30 active:scale-95 transition-all border border-indigo-500/30">
                        Create Account <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- SUBSCRIPTION LOCK SCREEN -->
        <div id="subscriptionScreen" class="absolute inset-0 bg-slate-950 z-[180] flex flex-col px-4 hidden overflow-y-auto sm:rounded-[2.5rem] pb-8">
            <div class="pt-10 pb-6 text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-rose-500 to-rose-700 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-rose-500/30 border border-rose-400/30">
                    <i class="fa-solid fa-lock text-2xl text-white"></i>
                </div>
                <h2 class="text-xl font-bold text-white tracking-tight">Recharge Required / Expired</h2>
                <p id="expiryReasonText" class="text-[11px] text-slate-400 mt-2 max-w-[250px] mx-auto leading-relaxed">Aapka recharge plan ya trial khatam ho chuka hai. App ko chalane ke liye dobara recharge karein.</p>
            </div>
            
            <div class="space-y-4 max-w-sm mx-auto w-full">
                <div onclick="initiatePayment(15, 'subscription', 28)" class="bg-slate-900 border border-slate-700 rounded-2xl p-4 flex justify-between items-center cursor-pointer hover:border-indigo-500 active:scale-95 transition group">
                    <div>
                        <h3 class="text-indigo-400 font-bold text-sm">28 Din Plan</h3>
                        <p class="text-[10px] text-slate-500 mt-0.5">Basic access for 1 month</p>
                    </div>
                    <div class="bg-slate-800 text-white font-extrabold text-lg px-4 py-2 rounded-xl group-hover:bg-indigo-600 transition">₹15</div>
                </div>

                <div onclick="initiatePayment(20, 'subscription', 65)" class="bg-slate-900 border border-slate-700 rounded-2xl p-4 flex justify-between items-center cursor-pointer hover:border-emerald-500 active:scale-95 transition group relative overflow-hidden">
                    <div class="absolute -right-6 top-3 bg-emerald-500 text-white text-[8px] font-bold py-0.5 px-6 rotate-45 shadow-sm">BEST VALUE</div>
                    <div>
                        <h3 class="text-emerald-400 font-bold text-sm">65 Din Plan</h3>
                        <p class="text-[10px] text-slate-500 mt-0.5">Extended access for 2+ months</p>
                    </div>
                    <div class="bg-slate-800 text-white font-extrabold text-lg px-4 py-2 rounded-xl group-hover:bg-emerald-600 transition">₹20</div>
                </div>

                <div onclick="initiatePayment(30, 'subscription', 84)" class="bg-slate-900 border border-slate-700 rounded-2xl p-4 flex justify-between items-center cursor-pointer hover:border-amber-500 active:scale-95 transition group">
                    <div>
                        <h3 class="text-amber-400 font-bold text-sm">84 Din Plan</h3>
                        <p class="text-[10px] text-slate-500 mt-0.5">Premium access for almost 3 months</p>
                    </div>
                    <div class="bg-slate-800 text-white font-extrabold text-lg px-4 py-2 rounded-xl group-hover:bg-amber-600 transition">₹30</div>
                </div>
            </div>
            
            <button onclick="logoutProfile()" class="text-[10px] text-slate-500 font-semibold mt-10 hover:text-white transition w-full text-center"><i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Logout Account</button>
        </div>

        <!-- STAFF LIMIT REACHED MODAL -->
        <div id="staffLimitModal" class="fixed inset-0 bg-slate-950/80 z-[250] flex items-center justify-center p-4 hidden backdrop-blur-md transition-all">
            <div class="bg-white w-full max-w-sm rounded-[2rem] overflow-hidden shadow-2xl">
                <div class="bg-gradient-to-r from-rose-600 to-rose-800 p-4 text-center relative">
                    <button onclick="closeModal('staffLimitModal')" class="absolute top-4 right-4 w-7 h-7 rounded-full bg-white/20 text-white flex items-center justify-center"><i class="fa-solid fa-xmark text-xs"></i></button>
                    <h2 class="text-white font-bold text-lg">Staff Limit Reached</h2>
                </div>
                <div class="p-6 text-center bg-slate-50">
                    <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-4 text-rose-500 text-2xl shadow-inner border border-rose-200">
                        <i class="fa-solid fa-user-lock"></i>
                    </div>
                    <p class="text-xs text-slate-600 mb-4 leading-relaxed">Aap sirf apna pehla staff free mein add kar sakte hain.<br>Naya staff add karne ke liye <b>₹10</b> ka charge lagega.</p>
                    <button onclick="payForStaff()" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold text-sm shadow-md active:scale-95 transition-all shadow-emerald-500/30">Pay ₹10 & Add New Staff</button>
                </div>
            </div>
        </div>

        <!-- PAYMENT QR MODAL -->
        <div id="paymentModal" class="fixed inset-0 bg-slate-950/90 z-[260] flex flex-col items-center justify-center p-4 hidden backdrop-blur-md transition-all">
            <div class="bg-white w-full max-w-sm rounded-[2rem] overflow-hidden shadow-2xl animate-in fade-in zoom-in-95 duration-150">
                <div class="bg-indigo-600 p-4 text-center relative">
                    <button onclick="closeModal('paymentModal')" class="absolute top-4 right-4 w-7 h-7 rounded-full bg-white/20 text-white flex items-center justify-center"><i class="fa-solid fa-xmark text-xs"></i></button>
                    <h2 class="text-white font-bold text-lg">Payment Checkout</h2>
                    <p class="text-indigo-200 text-[10px] mt-0.5">Amount: <b id="payAmountDisplay" class="text-white">₹0</b> for <b id="payDaysDisplay" class="text-white">...</b></p>
                </div>
                
                <div class="p-5 flex flex-col items-center justify-center bg-slate-50">
                    <a id="directUpiBtn" href="#" target="_top" class="w-full py-3.5 mb-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold text-sm shadow-md active:scale-95 transition-all text-center flex items-center justify-center gap-2 hover:shadow-lg">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/e/e1/UPI-Logo-vector.svg" class="h-4 bg-white px-1.5 rounded-sm" alt="UPI">
                        Pay via PhonePe / UPI
                    </a>
                    
                    <div class="flex items-center gap-3 w-full mb-3">
                        <hr class="flex-1 border-slate-200">
                        <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">OR SCAN QR</span>
                        <hr class="flex-1 border-slate-200">
                    </div>

                    <img id="qrImageFallback" src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=upi%3A%2F%2Fpay%3Fpa%3DQ269658254%40ybl%26pn%3DMr.%20Mahtab%20Alam" alt="Payment QR" class="w-36 h-36 object-contain rounded-xl shadow-sm border border-slate-200 p-1 bg-white">
                    
                    <p class="text-xs font-bold text-slate-800 mt-2">Pay to Mr. Mahtab Alam</p>
                    <p class="text-[9px] text-slate-500">UPI ID: Q269658254@ybl</p>
                    
                    <div class="w-full mt-4 space-y-2 border-t border-slate-200 pt-4">
                        <label class="text-[10px] font-semibold text-slate-600 block text-center">Payment successful? Enter 12-digit UTR/Ref No. below:</label>
                        <input type="number" id="utrInput" placeholder="e.g. 320158493021" class="w-full text-xs p-3 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none text-center font-bold tracking-widest text-slate-700 bg-white">
                        <button onclick="verifyPayment()" class="w-full py-3 rounded-xl bg-emerald-500 text-white font-bold text-xs shadow-md active:scale-95 transition-all mt-2">Verify & Activate</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="toast" class="fixed top-4 left-1/2 -translate-x-1/2 z-[9999] px-3.5 py-2 rounded-full text-[10px] font-semibold text-white shadow-2xl transition-all duration-300 opacity-0 pointer-events-none flex items-center gap-2 border border-white/20"></div>

        <!-- MAIN DASHBOARD CONTENT -->
        <header id="mainHeader" class="bg-gradient-to-r from-slate-950 via-indigo-950 to-slate-900 text-white p-3.5 sticky top-0 z-30 shadow-xl border-b border-indigo-500/20">
            <div class="flex justify-between items-center gap-2">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div id="headerProfileIcon" onclick="openProfileModal()" class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-indigo-600 to-indigo-800 flex items-center justify-center border border-indigo-300/30 shadow-md shadow-indigo-600/30 flex-shrink-0 relative cursor-pointer active:scale-90 transition-transform">
                        <i class="fa-solid fa-user-check text-amber-300 text-sm"></i>
                        <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-slate-950 pulse-dot"></span>
                    </div>
                    <div class="truncate">
                        <h1 id="headerBusinessName" class="font-bold text-xs tracking-tight leading-tight text-white flex items-center gap-1.5">
                            Staff Pro <span class="bg-amber-400/20 text-amber-300 text-[8px] px-1.5 py-0.5 rounded-full font-semibold uppercase tracking-wider border border-amber-400/30">EXECUTIVE</span>
                        </h1>
                        <span id="headerOwnerName" class="text-[9px] text-indigo-300/80 block font-normal mt-0.5 truncate">Attendance & Duty Hours Engine</span>
                    </div>
                </div>
                <button onclick="checkStaffLimitAndOpen()" class="bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 hover:from-emerald-600 hover:to-teal-600 text-white px-3 py-1.5 rounded-xl text-[10px] font-semibold shadow-md shadow-emerald-950/40 flex items-center gap-1 flex-shrink-0 active:scale-95 transition border border-emerald-400/30">
                    <i class="fa-solid fa-plus text-[9px]"></i> Add Staff
                </button>
            </div>
            <div id="expiryBanner" class="hidden mt-2.5 text-[9px] font-bold text-center py-1 rounded border shadow-sm"></div>
        </header>

        <main id="mainContent" class="flex-1 p-3 overflow-y-auto space-y-3 no-scrollbar pb-24">
            <!-- Attendance Tab -->
            <section id="tab-staff" class="space-y-3">
                <div class="grid grid-cols-3 gap-2 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-950 p-3 rounded-2xl text-white shadow-lg border border-indigo-800/30 card-glow">
                    <div class="bg-white/5 backdrop-blur-md p-2 rounded-xl border border-white/10 text-center flex flex-col justify-center">
                        <p class="text-[8px] text-indigo-200 uppercase font-semibold tracking-wider opacity-80">Total Staff</p>
                        <p id="stat-total-staff" class="text-sm font-bold text-white mt-0.5">0</p>
                    </div>
                    <div class="bg-emerald-500/15 backdrop-blur-md p-1.5 rounded-xl border border-emerald-400/20 text-center flex flex-col justify-center">
                        <p class="text-[8px] text-emerald-300 uppercase font-semibold tracking-wider">Present</p>
                        <p id="stat-present-today" class="text-sm font-bold text-emerald-400 mt-0.5">0</p>
                    </div>
                    <div class="bg-rose-500/15 backdrop-blur-md p-1.5 rounded-xl border border-rose-400/20 text-center flex flex-col justify-center">
                        <p class="text-[8px] text-rose-300 uppercase font-semibold tracking-wider">Absent</p>
                        <p id="stat-absent-today" class="text-sm font-bold text-rose-400 mt-0.5">0</p>
                    </div>
                </div>

                <div class="bg-white p-1.5 rounded-xl border border-slate-200/90 shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-magnifying-glass text-indigo-500 text-[10px] ml-2"></i>
                    <input type="text" id="staffSearchInput" onkeyup="filterStaffList()" placeholder="Search staff by name or phone..." class="w-full text-[11px] font-normal bg-transparent border-none outline-none text-slate-800 placeholder-slate-400">
                </div>

                <div class="flex justify-between items-center bg-white border border-slate-200/90 rounded-xl p-1.5 shadow-sm">
                    <button onclick="changeDate(-1)" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center hover:bg-slate-200 active:scale-90 transition"><i class="fa-solid fa-chevron-left text-[10px]"></i></button>
                    
                    <button onclick="openCustomDatePicker('main')" class="flex items-center gap-1.5 px-3 py-1 bg-indigo-50/90 hover:bg-indigo-100/80 border border-indigo-100/80 rounded-lg transition active:scale-95 shadow-sm">
                        <i class="fa-regular fa-calendar-days text-indigo-600 text-[10px]"></i>
                        <span id="dateDisplayLabel" class="text-[11px] font-bold text-indigo-950">Sun, 02 Aug 2026</span>
                        <i class="fa-solid fa-angle-down text-indigo-400 text-[9px]"></i>
                    </button>

                    <button onclick="changeDate(1)" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center hover:bg-slate-200 active:scale-90 transition"><i class="fa-solid fa-chevron-right text-[10px]"></i></button>
                </div>

                <input type="hidden" id="attendanceDate">
                <div id="staffCardsContainer" class="space-y-2.5"></div>
            </section>

            <!-- History Tab -->
            <section id="tab-register" class="hidden space-y-3">
                <div class="bg-white p-2.5 rounded-2xl border border-slate-200/90 shadow-sm space-y-1.5">
                    <div class="flex justify-between items-center">
                        <span class="text-[10px] font-semibold text-slate-700 flex items-center gap-1">
                            <i class="fa-solid fa-user-tag text-indigo-600"></i> Select Staff:
                        </span>
                        <span id="selectedStaffBadge" class="text-[9px] font-bold bg-indigo-50 text-indigo-600 px-2 py-0.5 rounded-full border border-indigo-100">None</span>
                    </div>
                    <div id="staffPillsContainer" class="flex gap-1.5 overflow-x-auto no-scrollbar py-0.5"></div>
                </div>

                <div class="flex justify-between items-center bg-gradient-to-r from-indigo-50/80 to-slate-50 p-2 rounded-xl border border-indigo-100/80 shadow-sm">
                    <span class="text-[10px] font-bold text-indigo-950 flex items-center gap-1.5">
                        <i class="fa-solid fa-clock-rotate-left text-indigo-600"></i> History
                    </span>
                    <button onclick="openCustomMonthPicker('register')" class="flex items-center gap-1 px-2.5 py-1 bg-white border border-indigo-200/80 rounded-lg text-indigo-800 font-bold text-[10px] hover:bg-indigo-50 active:scale-95 transition shadow-sm">
                        <i class="fa-regular fa-calendar-days text-indigo-500"></i>
                        <span id="registerMonthLabel">August 2026</span>
                        <i class="fa-solid fa-angle-down text-indigo-400 text-[9px]"></i>
                    </button>
                    <input type="hidden" id="registerMonth">
                </div>

                <div id="individualLogContainer" class="space-y-1.5"></div>
            </section>

            <!-- Payroll Tab -->
            <section id="tab-salary" class="hidden space-y-3">
                <div class="flex justify-between items-center bg-white p-2.5 rounded-xl border border-slate-200/90 shadow-sm">
                    <span class="text-[10px] font-semibold text-slate-700 flex items-center gap-1.5">
                        <i class="fa-solid fa-calendar-check text-indigo-600"></i> Payroll Month:
                    </span>
                    <div class="flex items-center gap-2">
                        <button onclick="downloadSalaryPDF()" class="flex items-center gap-1 px-2.5 py-1 bg-rose-50 border border-rose-100 rounded-lg text-rose-600 font-bold text-[10px] hover:bg-rose-100 active:scale-95 transition shadow-sm">
                            <i class="fa-solid fa-file-pdf"></i> PDF
                        </button>
                        <button onclick="openCustomMonthPicker('salary')" class="flex items-center gap-1 px-2.5 py-1 bg-indigo-50/80 border border-indigo-100 rounded-lg text-indigo-950 font-bold text-[10px] hover:bg-indigo-100 active:scale-95 transition shadow-sm">
                            <i class="fa-regular fa-calendar text-indigo-600"></i>
                            <span id="salaryMonthLabel">August 2026</span>
                            <i class="fa-solid fa-angle-down text-indigo-400 text-[9px]"></i>
                        </button>
                    </div>
                    <input type="hidden" id="salaryMonth">
                </div>

                <div id="salarySummaryCard" class="bg-gradient-to-br from-emerald-800 via-teal-900 to-slate-950 text-white p-3.5 rounded-2xl shadow-xl space-y-2 relative overflow-hidden border border-emerald-500/30 emerald-glow">
                    <div class="absolute -right-4 -bottom-4 opacity-10 text-6xl text-white">
                        <i class="fa-solid fa-calculator"></i>
                    </div>
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-[9px] text-emerald-200/80 font-semibold tracking-wider uppercase">Total Earned (Kul Bana)</p>
                            <h3 id="totalSalaryAmount" class="text-xl font-extrabold tracking-tight mt-0.5 text-white">₹0</h3>
                        </div>
                        <div class="text-right">
