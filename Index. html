        function saveNewStaff() {
            const name = document.getElementById('newStaffName').value.trim();
            const phone = document.getElementById('newStaffPhone').value.trim();
            const salary = document.getElementById('newStaffSalary').value.trim();
            const salaryType = document.querySelector('input[name="newStaffSalaryType"]:checked').value;
            if (!name || !phone || !salary) { showToast("Please fill all fields", "error"); return; }
            window.state.staff.push({ id: Date.now().toString(), name, phone, salary: parseFloat(salary), salaryType });
            saveToCloud();
            document.getElementById('newStaffName').value = ''; document.getElementById('newStaffPhone').value = ''; document.getElementById('newStaffSalary').value = '';
            closeModal('addStaffModal'); showToast("Staff added successfully"); renderAttendanceTab(); updateDashboardStats();
