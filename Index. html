        function saveAdvance() {
            const staffId = document.getElementById('advanceStaffId').value;
            const amt = document.getElementById('advanceAmount').value;
            const date = document.getElementById('advanceDate').value;
            const paymentType = document.querySelector('input[name="paymentType"]:checked').value;
            const receiverName = document.getElementById('receiverName').value.trim();
            const note = document.getElementById('advanceNote').value.trim(); 

            if (!amt || !date) { showToast("Enter amount and date", "error"); return; }
            if (paymentType === 'home' && !receiverName) { showToast("Please enter name", "error"); return; }
            
            window.state.advances.push({ 
                id: Date.now().toString(), 
                staffId, 
                amount: parseFloat(amt), 
                date,
                paymentType,
                receiverName,
                note
            });
            
            saveToCloud(); 
            closeModal('addAdvanceModal'); 
