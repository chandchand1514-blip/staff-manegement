        async function checkSubscriptionStatus() {
            if (!window.state.profile) return true; 
            
            const now = await getInternetTime();
            let isExpired = false;
            let expiryReasonText = "";

            if (window.state.planExpiryDate) {
                const expiry = new Date(window.state.planExpiryDate).getTime();
                if (now > expiry) {
                    isExpired = true;
                    expiryReasonText = "Aapka recharge plan expire ho chuka hai. App ko aage use karne ke liye naya plan select karein.";
                }
            } else {
                const totalPresents = getTotalGlobalPresents();
                if (totalPresents >= 4) {
                    isExpired = true;
                    expiryReasonText = "Aapka free trial (3 presents limit) khatam ho gaya hai. App ko chalane ke liye recharge karein.";
                }
            }

            if(isExpired && expiryReasonText) {
                document.getElementById('expiryReasonText').textContent = expiryReasonText;
            }

            return !isExpired;
        }

