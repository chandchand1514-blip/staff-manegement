    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Safe Firebase Configuration Initialization
        let firebaseConfig = {
            apiKey: "AIzaSyDemoApiKeyForStandaloneApp12345",
            authDomain: "staff-payroll-app.firebaseapp.com",
            projectId: "staff-payroll-app",
            storageBucket: "staff-payroll-app.appspot.com",
            messagingSenderId: "123456789012",
            appId: "1:123456789012:web:abcdef123456789"
        };

        try {
            if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                firebaseConfig = JSON.parse(__firebase_config);
            }
        } catch(e) {
            console.log("Using default config setup");
        }

        let app, auth, db;
        try {
            app = initializeApp(firebaseConfig);
            auth = getAuth(app);
            db = getFirestore(app);
        } catch(e) {
            console.warn("Firebase fallback mode active", e);
        }

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-staff-app';
        let currentUserId = 'local_user';

        // Shared Application State
        window.state = {
            currentDate: new Date(),
            registerSelectedMonth: new Date(),
            salarySelectedMonth: new Date(),
            selectedStaffId: null,
            staff: [],
            attendance: {},
            advances: [],
            profile: null,
            planExpiryDate: null, 
            createdAt: null
        };

        let tempCalDate = new Date(window.state.currentDate);
        let activeMonthPickerTarget = null;
        let tempMonthPickerDate = new Date();
        let activeDatePickerTarget = 'main'; 
        
        let paymentContext = 'subscription'; 
        let selectedPaymentValue = 0;
        let selectedPaymentAmount = 0;

        // Initialize Local Storage Backup
        function loadFromLocalStorage() {
            try {
                const data = localStorage.getItem('staff_pro_state');
                if (data) {
                    const parsed = JSON.parse(data);
                    window.state.staff = parsed.staff || [];
                    window.state.attendance = parsed.attendance || {};
                    window.state.advances = parsed.advances || [];
                    window.state.profile = parsed.profile || null;
                    window.state.planExpiryDate = parsed.planExpiryDate || null;
                    window.state.createdAt = parsed.createdAt || null;
                }
            } catch(e) {
                console.error("Local storage error:", e);
            }
        }

        function saveToLocalStorage() {
            try {
                localStorage.setItem('staff_pro_state', JSON.stringify({
                    staff: window.state.staff,
                    attendance: window.state.attendance,
                    advances: window.state.advances,
                    profile: window.state.profile,
                    planExpiryDate: window.state.planExpiryDate,
                    createdAt: window.state.createdAt
                }));
            } catch(e) {
                console.error("Local save error:", e);
            }
        }

        const initAuth = async () => {
            loadFromLocalStorage();
            if (auth) {
                try {
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }
                } catch (e) {
                    console.log("Auth silent step", e);
                }
            }
            initApp();
        };

        initAuth();

        if (auth) {
            onAuthStateChanged(auth, async (user) => {
                if (user) {
                    currentUserId = user.uid;
                    await checkCurrentSession();
                    initApp();
                }
            });
        }

        async function checkCurrentSession() {
            if (!db) return;
            try {
                const sessionRef = doc(db, 'artifacts', appId, 'users', currentUserId, 'appState', 'currentSession');
                const sessionSnap = await getDoc(sessionRef);
                if (sessionSnap.exists() && sessionSnap.data().activeEmail) {
                    await loadDataForEmail(sessionSnap.data().activeEmail);
                }
            } catch (e) {
                console.log("Session fallback");
            }
