        function deleteStaff(staffId) { document.getElementById('staffToDeleteId').value = staffId; openModal('confirmDeleteModal'); }
        function executeDeleteStaff() {
            const staffId = document.getElementById('staffToDeleteId').value;
            if(!staffId) return;
            window.state.staff = window.state.staff.filter(s => s.id !== staffId);
            window.state.advances = window.state.advances.filter(a => a.staffId !== staffId);
            for (let date in window.state.attendance) if (window.state.attendance[date][staffId]) delete window.state.attendance[date][staffId];
            if(window.state.selectedStaffId === staffId) window.state.selectedStaffId = null;
            saveToCloud(); 
            closeModal('confirmDeleteModal'); 
            renderAttendanceTab(document.getElementById('staffSearchInput').value); 
            updateDashboardStats();
            if(!document.getElementById('tab-register').classList.contains('hidden')) { renderStaffPills(); renderIndividualRegister(); }
            showToast("Staff deleted permanently", "success");
        }

        async function markAttendance(staffId, status) {
            const dateStr = formatDateForInput(window.state.currentDate);
            
            const hasAccess = await checkSubscriptionStatus();
            
            if (!hasAccess) {
                document.getElementById('subscriptionScreen').classList.remove('hidden');
                hideMainDashboard();
                showToast("Recharge expired! Please renew your plan.", "error");
                return; 
            }

            if (!window.state.attendance[dateStr]) window.state.attendance[dateStr] = {};
            
            if (window.state.attendance[dateStr][staffId] === status) {
                 delete window.state.attendance[dateStr][staffId];
            } else {
                 window.state.attendance[dateStr][staffId] = status;
            }
            
            saveToCloud(); 
            renderAttendanceTab(document.getElementById('staffSearchInput').value); 
            updateDashboardStats();
        }

        function updateDashboardStats() {
            const dateStr = formatDateForInput(window.state.currentDate);

            let presentToday = 0; let absentToday = 0;

            if (window.state.attendance[dateStr]) {
                Object.keys(window.state.attendance[dateStr]).forEach(staffId => {
                    if (window.state.staff.find(s => s.id === staffId)) {
                        if (window.state.attendance[dateStr][staffId] === 'present') presentToday++;
                        if (window.state.attendance[dateStr][staffId] === 'absent') absentToday++;
                    }
                });
            }

            document.getElementById('stat-total-staff').textContent = window.state.staff.length;
            document.getElementById('stat-present-today').textContent = presentToday;
            document.getElementById('stat-absent-today').textContent = absentToday;
        }

