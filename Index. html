        function renderAttendanceTab(filterTxt = '') {
            const container = document.getElementById('staffCardsContainer');
            container.innerHTML = '';
            const dateStr = formatDateForInput(window.state.currentDate);
            
            const year = window.state.currentDate.getFullYear();
            const month = window.state.currentDate.getMonth();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const monthPrefix = `${year}-${String(month + 1).padStart(2, '0')}`;
            
            let displayStaff = window.state.staff;
            if (filterTxt) displayStaff = window.state.staff.filter(s => s.name.toLowerCase().includes(filterTxt.toLowerCase()) || s.phone.includes(filterTxt.toLowerCase()));

            if (displayStaff.length === 0) {
                container.innerHTML = `<div class="text-center py-6 text-slate-400 text-xs"><i class="fa-solid fa-users-slash text-2xl mb-2 opacity-50 block"></i>No staff found. Click "Add Staff" above.</div>`; return;
            }

            displayStaff.forEach(staff => {
                const status = window.state.attendance[dateStr]?.[staff.id] || null;
                const isPresent = status === 'present';
                const isAbsent = status === 'absent';
                
                let monthPresent = 0;
                let monthAbsent = 0;
                for (let i = 1; i <= daysInMonth; i++) {
                    const dStr = `${monthPrefix}-${String(i).padStart(2, '0')}`;
                    if (window.state.attendance[dStr]?.[staff.id] === 'present') monthPresent++;
                    if (window.state.attendance[dStr]?.[staff.id] === 'absent') monthAbsent++;
                }
                
                const card = document.createElement('div');
                card.className = "bg-white p-3 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between";
                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold border border-slate-200 shrink-0">
                            ${staff.name.charAt(0).toUpperCase()}
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-800 text-xs">${staff.name}</h3>
