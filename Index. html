                            <div class="bg-slate-50 p-1.5 rounded-lg border border-slate-200 shadow-sm text-center flex flex-col justify-center">
                                <span class="text-[8px] text-slate-500 uppercase font-semibold block">Earned (Is Mahine)</span>
                                <span class="text-[10px] font-bold text-slate-700">${formatCurrency(thisMonthEarned)}</span>
                            </div>
                            
                            <div class="bg-slate-50 p-1.5 rounded-lg border border-slate-100 text-center flex flex-col justify-center">
                                <span class="text-[8px] text-slate-500 uppercase font-semibold block">Paid (Is Mahine)</span>
                                <span class="text-[10px] font-bold text-slate-700">${formatCurrency(thisMonthStaffPaid)}</span>
                            </div>

                            <div class="bg-indigo-50 p-1.5 rounded-lg border border-indigo-100 shadow-sm text-center flex flex-col justify-center">
                                <span class="text-[8px] text-indigo-600 font-semibold block uppercase">Hath Me (Staff)</span>
                                <span class="text-[10px] font-bold text-indigo-700">${formatCurrency(lifetimeStaffPaid)}</span>
                            </div>
                            
                            <div class="bg-amber-50 p-1.5 rounded-lg border border-amber-100 shadow-sm text-center flex flex-col justify-center">
                                <span class="text-[8px] text-amber-600 font-semibold block uppercase">Ghar Bheja</span>
                                <span class="text-[10px] font-bold text-amber-700">${formatCurrency(lifetimeHomePaid)}</span>
                            </div>
                        </div>

                        <div onclick="prepAdvanceModal('${staff.id}')" class="bg-rose-50 p-1.5 rounded-lg border border-rose-100 shadow-sm text-center cursor-pointer active:scale-95 transition hover:bg-rose-100 group relative flex flex-col justify-center mb-3">
                            <span class="text-[8px] text-rose-500 font-semibold flex justify-center items-center gap-1 uppercase">
                                Total Paid (Kul Diya) <i class="fa-solid fa-plus-circle text-[9px] text-rose-400 group-hover:text-rose-600 transition"></i>
                            </span>
                            <span class="text-[10px] font-bold text-rose-600">${formatCurrency(lifetimePaid + lifetimeHomePaid)}</span>
                        </div>

                        <div class="flex justify-between items-center bg-slate-800 text-white p-3 rounded-xl border border-slate-700 shadow-lg">
                            <span class="text-[9px] font-bold uppercase tracking-wider text-slate-300">Total Balance (Kul Baaki)</span>
                            <span class="text-base font-extrabold ${lifetimeBalance < 0 ? 'text-rose-400' : 'text-emerald-400'} block">${formatCurrency(lifetimeBalance)}</span>
                        </div>
                        ${advanceHistoryText}
                    </div>
                `;
            });

            if (window.state.staff.length === 0) {
                container.innerHTML = `<div class="text-center py-6 text-slate-400 text-xs">No payroll data available.</div>`;
            }

            document.getElementById('totalSalaryAmount').textContent = formatCurrency(grandTotalEarned);
            document.getElementById('totalAdvanceAmount').textContent = formatCurrency(grandTotalStaffPaid);
            document.getElementById('topPaidBreakdown').textContent = `Hath Me: ${formatCurrency(grandTotalStaffPaid)} | Ghar: ${formatCurrency(grandTotalHomePaid)}`;
            document.getElementById('totalNetBalanceAmount').textContent = formatCurrency(grandTotalNet);
            document.getElementById('totalStaffCountSalary').textContent = `${window.state.staff.length} Staff`;
        }

        function downloadSalaryPDF() {
            showToast("Generating PDF...", "success");
            const monthLabel = document.getElementById('salaryMonthLabel').innerText;
            const printArea = document.createElement('div');
            printArea.style.padding = '20px'; printArea.style.backgroundColor = '#ffffff'; printArea.style.fontFamily = "'Plus Jakarta Sans', sans-serif";
            printArea.innerHTML = `<h2 style="font-size: 20px; font-weight: 700; color: #0f172a; margin-bottom: 20px; text-align: center; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px;">Staff Payroll Report - ${monthLabel}</h2>`;
            const summaryCard = document.getElementById('salarySummaryCard').cloneNode(true);
            const breakdownContainer = document.getElementById('salaryBreakdownContainer').cloneNode(true);
            summaryCard.classList.remove('shadow-xl', 'emerald-glow');
            printArea.appendChild(summaryCard);
            const spacer = document.createElement('div'); spacer.style.height = '15px'; printArea.appendChild(spacer);
            printArea.appendChild(breakdownContainer);

            const opt = { margin: 0.3, filename: `Payroll_Report_${monthLabel.replace(' ', '_')}.pdf`, image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2, useCORS: true }, jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' } };
            html2pdf().set(opt).from(printArea).save().then(() => showToast("PDF Downloaded!", "success")).catch(err => { showToast("Error generating PDF", "error"); });
        }

        // Global Event Handlers
        window.openModal = openModal;
        window.closeModal = closeModal;
        window.switchTab = switchTab;
        window.changeDate = changeDate;
        window.openCustomDatePicker = openCustomDatePicker;
        window.prevCalendarMonth = prevCalendarMonth;
        window.nextCalendarMonth = nextCalendarMonth;
        window.selectCalendarDate = selectCalendarDate;
        window.setCalendarToday = setCalendarToday;
        window.openCustomMonthPicker = openCustomMonthPicker;
        window.changeMonthPickerYear = changeMonthPickerYear;
        window.selectMonthPickerMonth = selectMonthPickerMonth;
        window.setMonthPickerCurrentMonth = setMonthPickerCurrentMonth;
        window.filterStaffList = filterStaffList;
        window.saveNewStaff = saveNewStaff;
        window.toggleReceiverInput = toggleReceiverInput;
        window.prepAdvanceModal = prepAdvanceModal;
        window.saveAdvance = saveAdvance;
        window.deleteAdvance = deleteAdvance;
        window.deleteStaff = deleteStaff;
        window.executeDeleteStaff = executeDeleteStaff;
        window.markAttendance = markAttendance; 
        window.selectRegisterStaff = selectRegisterStaff;
        window.downloadSalaryPDF = downloadSalaryPDF;
        window.setAuthMode = setAuthMode;
        window.handleAuthSubmit = handleAuthSubmit;
        window.openProfileModal = openProfileModal;
        window.logoutProfile = logoutProfile;
        
        window.selectPlan = initiatePayment;
        window.verifyPayment = verifyPayment;
        window.checkStaffLimitAndOpen = checkStaffLimitAndOpen;
        window.initiatePayment = initiatePayment;
        window.payForStaff = payForStaff;

    </script>
</body>
</html>
