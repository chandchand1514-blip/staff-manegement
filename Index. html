        async function handleAuthSubmit() {
            const email = document.getElementById('profileEmail').value.trim();
            const password = document.getElementById('profilePassword').value;

            if(!email || !password) {
                showToast("Email aur Password daalna zaroori hai", "error");
                return;
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if(!emailRegex.test(email)) {
                showToast("Sahi Email ID daaliye", "error");
                return;
            }

            const loader = document.getElementById('cloudLoadingOverlay');
            loader.classList.remove('hidden');

            try {
                if (authMode === 'signup') {
                    const name = document.getElementById('profileName').value.trim();
                    const confirmPassword = document.getElementById('profileConfirmPassword').value;

                    if(!name || !confirmPassword) {
                        showToast("Kripya sabhi details bharein", "error");
                        loader.classList.add('hidden');
                        return;
                    }
                    if(password !== confirmPassword) {
                        showToast("Passwords match nahi kar rahe!", "error");
                        loader.classList.add('hidden');
                        return;
                    }

                    window.state.profile = { name, email, password, staffLimit: 1 };
                    window.state.staff = window.state.staff || [];
                    window.state.attendance = window.state.attendance || {};
                    window.state.advances = window.state.advances || [];
                    window.state.createdAt = new Date().toISOString();
                    window.state.planExpiryDate = null;
                    
                    await saveToCloud();
                    await setSession(email);

                } else if (authMode === 'login') {
                    if (!window.state.profile) {
                        window.state.profile = { name: email.split('@')[0], email, password, staffLimit: 1 };
                    } else {
                        window.state.profile.email = email;
                    }
                    await setSession(email);
                }

                setTimeout(() => {
                    loader.classList.add('hidden');
                    document.getElementById('onboardingScreen').classList.add('hidden');
                    loadProfileData();
                    initApp(); 
                    showToast(authMode === 'login' ? "Login Successful!" : "Account Created!", "success");
                }, 800);

            } catch (e) {
                console.error(e);
                loader.classList.add('hidden');
                showToast("Login error", "error");
            }
        }

