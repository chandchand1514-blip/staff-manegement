        window.verifyPayment = async function() {
            const utr = document.getElementById('utrInput').value.trim();
            if(utr.length < 10) {
                showToast("Please enter a valid 12-digit UTR number", "error");
                return;
            }

            showToast("Verifying payment...", "success");
            
            setTimeout(async () => {
                if (paymentContext === 'subscription') {
                    const now = new Date();
                    let newExpiry;
                    if (window.state.planExpiryDate && new Date(window.state.planExpiryDate) > now) {
                        newExpiry = new Date(window.state.planExpiryDate);
                    } else {
                        newExpiry = new Date();
                    }
                    newExpiry.setDate(newExpiry.getDate() + selectedPaymentValue);
                    window.state.planExpiryDate = newExpiry.toISOString();
                } else if (paymentContext === 'add_staff') {
                    if(!window.state.profile.staffLimit) window.state.profile.staffLimit = 1;
                    window.state.profile.staffLimit += selectedPaymentValue;
                }
                
                try {
                    await saveToCloud();
                    closeModal('paymentModal');
                    
                    if (paymentContext === 'subscription') {
                        document.getElementById('subscriptionScreen').classList.add('hidden');
                        document.getElementById('mainHeader').classList.remove('hidden');
                        document.getElementById('mainContent').classList.remove('hidden');
                        document.getElementById('mainNav').classList.remove('hidden');
                        
                        showToast(`Recharge Successful! Valid for ${selectedPaymentValue} days.`, "success");
