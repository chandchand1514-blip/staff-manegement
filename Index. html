        async function loadDataForEmail(email) {
            if (!db) return false;
            try {
                const emailKey = email.toLowerCase();
                const docRef = doc(db, 'artifacts', appId, 'users', currentUserId, 'appState', emailKey);
                const docSnap = await getDoc(docRef);
                if (docSnap.exists()) {
                    const data = docSnap.data();
                    window.state.staff = data.staff || [];
                    window.state.attendance = data.attendance || {};
                    window.state.advances = data.advances || [];
                    window.state.profile = data.profile || null;
                    window.state.planExpiryDate = data.planExpiryDate || null;
                    window.state.createdAt = data.createdAt || null;
                    if(window.state.profile && !window.state.profile.staffLimit) {
                        window.state.profile.staffLimit = 1;
                    }
                    saveToLocalStorage();
                    return true;
                }
            } catch(e) {
                console.log("Cloud load error, using local data");
            }
            return false;
        }

        async function setSession(email) {
            if (!db) return;
            try {
                const sessionRef = doc(db, 'artifacts', appId, 'users', currentUserId, 'appState', 'currentSession');
                await setDoc(sessionRef, { activeEmail: email ? email.toLowerCase() : null });
            } catch(e) {}
        }

        async function saveToCloud() {
            saveToLocalStorage();
            if (!db || !currentUserId || !window.state.profile) return;
            try {
                const emailKey = window.state.profile.email.toLowerCase();
                const docRef = doc(db, 'artifacts', appId, 'users', currentUserId, 'appState', emailKey);
                await setDoc(docRef, {
                    staff: window.state.staff,
                    attendance: window.state.attendance,
                    advances: window.state.advances,
                    profile: window.state.profile,
                    planExpiryDate: window.state.planExpiryDate,
                    createdAt: window.state.createdAt
                });
            } catch (e) {
                console.log("Cloud sync error, saved locally");
            }
        }

        function getTotalGlobalPresents() {
            let total = 0;
            for (const date in window.state.attendance) {
                for (const staffId in window.state.attendance[date]) {
                    if (window.state.attendance[date][staffId] === 'present') {
                        total++;
                    }
                }
