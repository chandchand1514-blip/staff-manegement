        function getLifetimeFinancials(staff) {
            let totalEarned = 0;
            let staffPaid = 0;
            let homePaid = 0;
            const isDaily = (staff.salaryType === 'daily');

            for (let dateStr in window.state.attendance) {
                if (window.state.attendance[dateStr][staff.id] === 'present') {
                    if (isDaily) {
                        totalEarned += staff.salary;
                    } else {
                        const [y, m] = dateStr.split('-');
                        const daysInMonth = new Date(parseInt(y), parseInt(m), 0).getDate();
                        totalEarned += (staff.salary / daysInMonth);
                    }
                }
            }
            
            window.state.advances.forEach(a => {
                if (a.staffId === staff.id) {
                    if (a.paymentType === 'home') {
                        homePaid += a.amount; 
                    } else {
                        staffPaid += a.amount; 
                    }
                }
            });

            return {
                earned: Math.round(totalEarned),
                staffPaid: Math.round(staffPaid),
                homePaid: Math.round(homePaid),
                paid: Math.round(staffPaid), 
                balance: Math.round(totalEarned - staffPaid - homePaid) 
            };
        }

